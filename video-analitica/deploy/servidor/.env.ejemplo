# Copiar a .env en el servidor y completar. .env NUNCA va al repo.
VIDEO_DB_PROVEEDOR=SqlServer
# Usuario con permisos solo sobre la base VideoAnalitica.
VIDEO_DB_CONEXION=
# base64 de 32 bytes aleatorios: head -c 32 /dev/urandom | base64
# Si se cambia, las estadías nuevas no se emparejan con las viejas.
VIDEO_CLAVE_HASH_PATENTE=
# Días de patente en texto antes de pasar a hash. Lo define el Owner.
VIDEO_RETENCION_PATENTE_DIAS=
# Solo con el perfil sqlserver-local (prueba sin el SQL Server de la compañía).
MSSQL_SA_PASSWORD=
